# =============================================================================
# Opportunity Hunter — environment variables
# =============================================================================
# Copy this file to `.env.local` (for the Next.js dev server) and fill in
# the values from your Supabase project:
#   https://app.supabase.com/project/_/settings/api
#
# NEVER commit a real `.env.local`. It is git-ignored on purpose.
# =============================================================================

# --- Public (exposed to the browser) ----------------------------------------
# These two are required for Supabase to work. They are safe to ship in
# the JS bundle; Supabase enforces RLS at the database level.

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# --- Server-only (NEVER prefix with NEXT_PUBLIC_) ---------------------------
# Used by background jobs, server actions, and the seed script. Grants
# full read/write access to the database and bypasses RLS.

SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_SECRET"

# Optional: direct Postgres connection string. Useful for the Supabase
# CLI (`supabase db reset`) or for running raw migrations from your
# machine. Format:
#   postgresql://postgres:password@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_URL=""

# --- External API Keys (optional) -------------------------------------------
# These are used by source providers to fetch data from external platforms.
# If not set, the corresponding source will be skipped gracefully.

# Product Hunt API token (Developer Token from https://www.producthunt.com/v2/oauth/applications)
PRODUCT_HUNT_TOKEN=""

# Twitter/X API Bearer Token (from https://developer.twitter.com/en/portal/dashboard)
TWITTER_BEARER_TOKEN=""

# IndieHackers API Key (unofficial RSS feed access)
INDIEHACKERS_API_KEY=""

# --- Email Notifications (Resend) -------------------------------------------
# Used by the Sprint 44 email pipeline. Get your API key from
# https://resend.com/api-keys

RESEND_API_KEY=""
EMAIL_FROM=""

# Stripe Environment Variables
# Get these from your Stripe dashboard
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for each plan (create these in Stripe Dashboard under Products > Prices)
PRICE_FREE=price_1Free...
PRICE_PRO=price_1Pro...
PRICE_TEAM=price_1Team...

# --- Cron Secret (Sprint 68 Phase 1) ---------------------------------------
# Shared secret for cron-triggered endpoints (`/api/jobs/*`).
#
# When set on Vercel, Vercel Cron AUTOMATICALLY sends:
#   `Authorization: Bearer <CRON_SECRET>`
# on every cron invocation. No `vercel.json` header config needed.
#
# The route also accepts `x-cron-secret: <CRON_SECRET>` for manual triggers
# (e.g. `curl -H "x-cron-secret: $CRON_SECRET" ...`).
#
# Generate a random 32+ char value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then paste it here AND in Vercel project env vars.
CRON_SECRET=""

# --- Auth helpers (Sprint 68) -----------------------------------------------
# Internal service-to-service token used when one server route needs to
# invoke another from outside a user session (e.g. backtest evaluation
# triggered after a committee vote). Must match across both copies of the
# app that share a deployment.
INTERNAL_API_TOKEN=""

# --- Public site URL (Sprint 70 H2) --------------------------------------
# Used for canonical URLs, OpenGraph, sitemap.xml, robots.txt.
# Production: https://opportunity-hunter-hn.vercel.app
# (override per-environment as needed)
NEXT_PUBLIC_SITE_URL="https://opportunity-hunter-hn.vercel.app"

# --- Sentry (Sprint 71 H3) ---------------------------------------------
# Error monitoring + performance tracing.
# Get DSN from https://sentry.io → Project Settings → Client Keys (DSN)
# Leave empty to disable Sentry entirely.

# Server-side DSN (Node.js + Edge runtimes)
SENTRY_DSN=""

# Browser-side DSN (NEXT_PUBLIC_* is exposed to client)
NEXT_PUBLIC_SENTRY_DSN=""

# Source map upload (only needed at build time; get from Sentry → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT="opportunity-hunter"
